# .htaccess file content for the /adresp directory

<IfModule mod_rewrite.c>
  # Turn on URL rewriting
  RewriteEngine On
  
  # Set the base directory for rewriting. This MUST match your 'basename' in React Router.
  # The trailing slash is important.
  RewriteBase /adresp/ 
  
  # 1. Skip files/directories that actually exist on the server.
  # If the request is for a file or directory that exists (e.g., /static/js/bundle.js, /images/logo.png),
  # then skip the rewrite rule and serve the file directly.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # 2. Rewrite everything else to index.html.
  # For all other requests (like /PosterReview), rewrite the URL internally to index.html.
  # The [L] flag means "Last rule," so no more rewriting is done after this.
  RewriteRule . /adresp/index.html [L]
</IfModule>
